# ─── Database ───────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bizzhouse
DATABASE_PASSWORD=bizzhouse_dev_2026
DATABASE_NAME=bizzhouse
DATABASE_URL=postgresql://bizzhouse:bizzhouse_dev_2026@localhost:5432/bizzhouse

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=7d

# ─── Initial platform admin (used by `npm run seed:admin`) ─────────
# NOTE: the identifier does not have to be a real email (e.g. admin@123)
DEFAULT_ADMIN_EMAIL=admin@123
DEFAULT_ADMIN_PASSWORD=password@123
DEFAULT_ADMIN_NAME=Platform Admin

# ─── Gupshup ───────────────────────────────────────────
# Partner credentials from partner.gupshup.io. There is NO mock mode:
# without these the API throws a clear configuration error instead of
# faking responses.
GUPSHUP_BASE_URL=https://partner.gupshup.io
GUPSHUP_EMAIL=your-partner-email@example.com
# The partner account password — sent as the `password` field of
# POST /partner/account/login (name kept for backwards compatibility)
GUPSHUP_CLIENT_SECRET=your-client-secret
# Public URL of this API (used as the Gupshup v3 callback target when
# registering each app's webhook subscription)
PUBLIC_API_BASE_URL=http://localhost:3001
# Shared secret delivered back as X-Gupshup-Webhook-Secret on every
# callback — set it in production to authenticate inbound webhooks
GUPSHUP_WEBHOOK_SECRET=

# ─── Razorpay (wallet recharge) ─────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_MOCK_MODE=true

# ─── S3 / MinIO ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=bizzhouse
S3_SECRET_KEY=bizzhouse_minio_2026
S3_BUCKET=bizzhouse-media
S3_REGION=us-east-1

# ─── App ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ─── Webhook ───────────────────────────────────────────
WEBHOOK_IP_WHITELIST=

# ─── Alerts (Phase 58/59) ───────────────────────────────
# Slack-compatible webhook for operational alerts (low balances, ledger drift).
# Leave empty to log alerts only.
ALERT_WEBHOOK_URL=
# Alert when the upstream Gupshup partner wallet (USD) drops below this
GUPSHUP_WALLET_ALERT_THRESHOLD_USD=50
# Alert when a shop's balance (paise) drops below this (500 = ₹5.00)
SHOP_LOW_BALANCE_THRESHOLD_PAISE=500
# Hours before the same alert key fires again
ALERT_COOLDOWN_HOURS=12

# ─── Broadcasts ─────────────────────────────────────────
# Delay between sequential broadcast sends (ms) — protects provider rate limits
BROADCAST_SEND_DELAY_MS=100
